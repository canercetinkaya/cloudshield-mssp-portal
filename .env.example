# ==============================================================================
# CloudShield Enterprise MSSP Security & Compliance Platform
# Environment Configuration Template (.env.example)
#
# Copy this file to .env (or configure in Azure Container Apps / Key Vault)
# DO NOT commit real secrets or production credentials to Git!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE SERVER & RUNTIME SETTINGS
# ------------------------------------------------------------------------------
# Port for the Python HTTP API and Web Portal (Default: 8080)
PORT=8080

# Runtime environment mode: development | staging | production
CLOUDSHIELD_ENV=development

# Release channel: pilot | stable
CLOUDSHIELD_RELEASE_CHANNEL=pilot

# Database file location (SQLite database for RBAC, sessions, and audit logs)
CLOUDSHIELD_DB_PATH=Data/cloudshield_rbac.db

# ------------------------------------------------------------------------------
# 2. PLATFORM ADMIN INITIAL BOOTSTRAP CREDENTIALS
# ------------------------------------------------------------------------------
# Username for the default Platform Administrator account
PORTAL_ADMIN_USER=admin

# Password for bootstrap admin (MUST be changed in production!)
# In local dev, falls back to Data/auth.local.json if not set.
PORTAL_ADMIN_PASSWORD=ChangeThisStrongPassword2026!*

# ------------------------------------------------------------------------------
# 3. AZURE CLOUD & KEY VAULT INTEGRATION (Production / Azure Container Apps)
# ------------------------------------------------------------------------------
# Azure Key Vault URI storing customer client secrets and certificates
AZURE_KEYVAULT_URL=https://cs-kv-qwy6we.vault.azure.net

# Azure Managed Identity endpoint and header (automatically set by Azure Container Apps)
# IDENTITY_ENDPOINT=
# IDENTITY_HEADER=

# Azure Resource Group and Container App Name
AZURE_RESOURCE_GROUP=rg-cloudshield-mssp
CONTAINER_APP_NAME=ca-cloudshield-portal

# ------------------------------------------------------------------------------
# 4. CI/CD & CONTAINER REGISTRY (GitHub Actions)
# ------------------------------------------------------------------------------
# Personal Access Token for pushing Docker images to GitHub Container Registry (GHCR)
# GHCR_PAT=ghp_example_token_with_write_packages_scope

# ------------------------------------------------------------------------------
# 5. OPTIONAL FALLBACKS & DEVELOPMENT OVERRIDES
# ------------------------------------------------------------------------------
# Direct client secret for local testing without Key Vault (STRICTLY FORBIDDEN IN PROD)
# MSSP_CLIENT_SECRET=
