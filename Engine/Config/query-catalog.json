    "QRY-GRAPH-THREAT-HUNTING": {
      "id": "QRY-GRAPH-THREAT-HUNTING",
      "name": "Microsoft Graph Threat Hunting KQL Query Execution",
      "target": "Graph",
      "endpoint": "https://graph.microsoft.com/v1.0/security/runHuntingQuery",
      "apiVersion": "v1.0",
      "status": "GA",
      "method": "POST",
      "availabilityState": "SupportedAdvancedHunting",
      "maxLookbackDays": 30,
      "rateLimit": "45 calls/min, 15 concurrent",
      "pagination": "Row limits (100,000)"
    },
    "QRY-MDE-MACHINES": {
      "id": "QRY-MDE-MACHINES",
      "name": "Defender for Endpoint Machines API",
      "target": "MDE",
      "endpoint": "https://api.securitycenter.microsoft.com/api/machines?$top=500",
      "apiVersion": "v1.0",
      "status": "GA",
      "method": "GET",
      "availabilityState": "SupportedAppOnly",
      "maxLookbackDays": 30,
      "rateLimit": "100 requests/min",
      "pagination": "@odata.nextLink"
    },
    "QRY-GRAPH-DEVICE-ASR": {
      "id": "QRY-GRAPH-DEVICE-ASR",
      "name": "Defender for Endpoint ASR Rule Events",
      "target": "Graph",
      "endpoint": "https://graph.microsoft.com/v1.0/security/runHuntingQuery",
      "kql": "DeviceEvents | where ActionType startswith 'Asr' | summarize Blocks=countif(ActionType endswith 'Blocked'), Audits=countif(ActionType endswith 'Audited') by Rule=tostring(AdditionalFields.RuleName)",
      "apiVersion": "v1.0",
      "status": "GA",
      "method": "POST",
      "availabilityState": "SupportedAdvancedHunting"
    },
    "QRY-GRAPH-TVM-VULNS": {
      "id": "QRY-GRAPH-TVM-VULNS",
      "name": "MDE Vulnerability Exposure and CISA KEV",
      "target": "Graph",
      "endpoint": "https://graph.microsoft.com/v1.0/security/runHuntingQuery",
      "kql": "DeviceTvmSoftwareVulnerabilities | summarize DistinctDevices=dcount(DeviceId) by CveId | top 10 by DistinctDevices desc",
      "apiVersion": "v1.0",
      "status": "GA",
      "method": "POST",
      "availabilityState": "SupportedAdvancedHunting"
    },
    "QRY-GRAPH-EMAIL-EVENTS": {
      "id": "QRY-GRAPH-EMAIL-EVENTS",
      "name": "Defender for Office 365 Inbound Threat Events",
      "target": "Graph",
      "endpoint": "https://graph.microsoft.com/v1.0/security/runHuntingQuery",
      "kql": "EmailEvents | summarize Total=count(), Blocked=countif(DeliveryAction == 'Blocked'), Phish=countif(ThreatTypes has 'Phish'), Malware=countif(ThreatTypes has 'Malware') by DeliveryAction",
      "apiVersion": "v1.0",
      "status": "GA",
      "method": "POST",
      "availabilityState": "SupportedAdvancedHunting"
    },
    "QRY-GRAPH-EMAIL-POST-DELIVERY": {
      "id": "QRY-GRAPH-EMAIL-POST-DELIVERY",
      "name": "Defender for Office 365 ZAP Actions",
      "target": "Graph",
      "endpoint": "https://graph.microsoft.com/v1.0/security/runHuntingQuery",
      "kql": "EmailPostDeliveryEvents | where ActionType has 'ZAP' | summarize ZapSuccess=countif(ActionResult == 'Success'), ZapFailed=countif(ActionResult != 'Success')",
      "apiVersion": "v1.0",
      "status": "GA",
      "method": "POST",
      "availabilityState": "SupportedAdvancedHunting"
    },
    "QRY-GRAPH-URL-CLICKS": {
      "id": "QRY-GRAPH-URL-CLICKS",
      "name": "Defender for Office 365 Safe Links Click Protection",
      "target": "Graph",
      "endpoint": "https://graph.microsoft.com/v1.0/security/runHuntingQuery",
      "kql": "UrlClickEvents | summarize TotalClicks=count(), Blocked=countif(ActionType == 'ClickBlocked'), Warned=countif(ActionType == 'ClickWarning') by ActionType",
      "apiVersion": "v1.0",
      "status": "GA",
      "method": "POST",
      "availabilityState": "SupportedAdvancedHunting"
    },
    "QRY-GRAPH-IDENTITY-LOGON": {
      "id": "QRY-GRAPH-IDENTITY-LOGON",
      "name": "Defender for Identity Insecure Protocols (NTLMv1 / LDAP)",
      "target": "Graph",
      "endpoint": "https://graph.microsoft.com/v1.0/security/runHuntingQuery",
      "kql": "IdentityLogonEvents | where Protocol in ('NTLMv1', 'Ntlm') or FailureReason has 'LDAP' | summarize InsecureLogons=count(), DistinctDevices=dcount(DeviceName) by Protocol",
      "apiVersion": "v1.0",
      "status": "GA",
      "method": "POST",
      "availabilityState": "SupportedAdvancedHunting"
    },
    "QRY-GRAPH-CLOUD-APP-EVENTS": {
      "id": "QRY-GRAPH-CLOUD-APP-EVENTS",
      "name": "Defender for Cloud Apps Shadow IT & Upload Volumes",
      "target": "Graph",
      "endpoint": "https://graph.microsoft.com/v1.0/security/runHuntingQuery",
      "kql": "CloudAppEvents | where ActionType in ('Upload', 'FileUploaded') | summarize TotalUploadBytes=sum(tolong(AdditionalFields.BytesUploaded)), Users=dcount(AccountName) by Application | top 10 by TotalUploadBytes desc",
      "apiVersion": "v1.0",
      "status": "GA",
      "method": "POST",
      "availabilityState": "SupportedAdvancedHunting"
    },
