{
  "": "http://json-schema.org/draft-07/schema#",
  "title": "CloudShieldKqlQueryMetadata",
  "type": "object",
  "required": [
    "id",
    "title",
    "service",
    "package",
    "targetTables",
    "severity",
    "queryFile"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "source": {
      "type": "object",
      "properties": {
        "origin": {
          "type": "string"
        },
        "author": {
          "type": "string"
        },
        "license": {
          "type": "string"
        },
        "updatedAt": {
          "type": "string"
        }
      }
    },
    "service": {
      "type": "string",
      "enum": [
        "XDR",
        "MDE",
        "MDO",
        "MDI",
        "MDCA",
        "ENTRA",
        "INTUNE",
        "PURVIEW"
      ]
    },
    "package": {
      "type": "string",
      "enum": [
        "MITRE",
        "Ransomware",
        "EmailSecurity",
        "IdentitySecurity",
        "Intune",
        "Purview"
      ]
    },
    "mitre": {
      "type": "object",
      "properties": {
        "tactics": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "techniques": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "targetTables": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "severity": {
      "type": "string",
      "enum": [
        "Critical",
        "High",
        "Medium",
        "Low",
        "Informational"
      ]
    },
    "requiredPermissions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "slaResponseHours": {
      "type": "number"
    },
    "raci": {
      "type": "string"
    },
    "runbook": {
      "type": "string"
    },
    "queryFile": {
      "type": "string"
    }
  }
}